{"probe_id": "patch_sem_gpt_4_1_ASSET_val_1801_9189c752", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "gpt-4.1", "base_item_id": "ASSET_val_1801", "base_text": "The term was coined by merging the name for the two orders, Cetacea and Artiodactyla, into a single word.", "probe_text": "The word was created by combining the names of the two orders, Cetacea and Artiodactyla, into one term.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
