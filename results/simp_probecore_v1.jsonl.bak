{"probe_id": "INV_SEM_llama-3.1-8b_ASSET_val_0346", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0346", "base_text": "Probably in the ninth century, the village became part of the territory of the monastery of Reichenau.", "probe_text": "In all likelihood around the ninth century, the village was incorporated into the domain of the Reichenau monastery.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-8b", "tier": 1, "dataset": "ASSET", "generator_model": "llama-3.1-8b", "rule_pass": true, "rule_detail": "recall=0.67,ratio=1.06"}
