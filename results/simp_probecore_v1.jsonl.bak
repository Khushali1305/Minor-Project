{"probe_id": "INV_SEM_gpt-4.1_ASSET_val_0791", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0791", "base_text": "With the help of an albatross named Orville, the mice fly to the Bayou, and meet a dragonfly named Evinrude, who speeds them in a leaf to the ship where Penny is held.", "probe_text": "Assisted by an albatross called Orville, the mice travel by air to the Bayou, where they encounter a dragonfly named Evinrude, who quickly ferries them on a leaf to the ship where Penny is being kept.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by gpt-4.1", "tier": 1, "dataset": "ASSET", "generator_model": "gpt-4.1", "rule_pass": true, "rule_detail": "recall=0.67,ratio=1.09"}
