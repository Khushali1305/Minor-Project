{"probe_id": "patch_sem_gpt_4_1_ASSET_val_1768_6bc5ef19", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "gpt-4.1", "base_item_id": "ASSET_val_1768", "base_text": "Ornamental plants are typically grown in the flower garden or as house plants.", "probe_text": "Usually, ornamental plants are cultivated in flower gardens or kept indoors as houseplants.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
