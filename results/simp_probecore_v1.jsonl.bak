{"probe_id": "patch_sem_qwen2_5_32b_ASSET_test_0004_5d937e85", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "qwen2.5-32b", "base_item_id": "ASSET_test_0004", "base_text": "The tarantula, the trickster character, spun a black cord and, attaching it to the ball, crawled away fast to the east, pulling on the cord with all his strength.", "probe_text": "The cunning tarantula crafted a dark thread, secured it to the sphere, and scurried swiftly towards the east, tugging at the string with utmost vigor.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
