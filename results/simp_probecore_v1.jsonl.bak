{"probe_id": "patch_sem_llama_3_1_8b_ASSET_test_0070_c0c9de80", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "llama-3.1-8b", "base_item_id": "ASSET_test_0070", "base_text": "There are statues of Sir Alf Ramsey and Sir Bobby Robson, both former Ipswich Town and England managers, outside the ground.", "probe_text": "Outside the stadium stand statues of two notable figures, Sir Alf Ramsey and Sir Bobby Robson, who have previously managed Ipswich Town as well as the English national team.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
{"probe_id": "patch_sem_gpt_4_1_ASSET_val_1826_b4753c83", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "gpt-4.1", "base_item_id": "ASSET_val_1826", "base_text": "Some of the computer models suggested the weakening tropical storm could be absorbed by a developing low to the west, which a few days later became Hurricane Epsilon.", "probe_text": "Certain computer models indicated that the weakening tropical storm might be taken in by a forming low-pressure system to the west, which turned into Hurricane Epsilon a few days afterward.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
