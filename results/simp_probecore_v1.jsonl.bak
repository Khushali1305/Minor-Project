{"probe_id": "INV_SEM_gemma-3-27b_ASSET_val_0790", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0790", "base_text": "It consists of the red cross of Saint George (patron saint of England), edged in white, superimposed on the Cross of St Patrick (patron saint of Ireland), which are superimposed on the Saltire of Saint Andrew (patron saint of Scotland).", "probe_text": "Composed of the white-bordered red cross representing Saint George, the protector of England, it is layered over the cross of Saint Patrick, Ireland’s patron saint, itself placed over the Saint Andrew’s Saltire—the symbol of Scotland.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by gemma-3-27b", "tier": 2, "dataset": "ASSET", "generator_model": "gemma-3-27b", "rule_pass": true, "rule_detail": "recall=0.65,ratio=0.88"}
