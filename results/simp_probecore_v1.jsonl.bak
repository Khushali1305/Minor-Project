{"probe_id": "INV_SEM_llama-3.1-70b_ASSET_val_0956", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0956", "base_text": "Solid metallic hydrogen consists of a crystal lattice of atomic nuclei (namely, protons), with a spacing which is significantly smaller than a Bohr radius.", "probe_text": "In solid metallic hydrogen, a crystalline lattice is formed by atomic nuclei, specifically protons, that are packed at a distance substantially less than the radius of a Bohr orbit.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-70b", "tier": 1, "dataset": "ASSET", "generator_model": "llama-3.1-70b", "rule_pass": true, "rule_detail": "recall=0.62,ratio=1.21"}
