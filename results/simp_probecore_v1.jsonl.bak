{"probe_id": "INV_SEM_gemma-3-27b_ASSET_val_0996", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0996", "base_text": "The following year, the title returned to Raw after reigning champion Triple H was drafted back to the brand during the 2009 WWE Draft.", "probe_text": "In the subsequent year, the championship was once again held on Raw following the WWE Draft in 2009, when then-champion Triple H was assigned back to that brand.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by gemma-3-27b", "tier": 1, "dataset": "ASSET", "generator_model": "gemma-3-27b", "rule_pass": true, "rule_detail": "recall=0.68,ratio=1.17"}
