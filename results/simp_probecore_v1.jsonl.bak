{"probe_id": "INV_SEM_gemma-3-27b_ASSET_val_0482", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0482", "base_text": "As well as current kit sponsors for Bayern Munich, Ferencvárosi TC, and West Bromwich Albion, T-Mobile were co-sponsors of Everton with the One2One brand and they also sponsored the 2002 FA Youth Cup Final.", "probe_text": "In addition to being the kit sponsor for teams including Bayern Munich, Ferencvárosi TC, and West Bromwich Albion, T-Mobile previously co-sponsored Everton alongside their One2One brand, and also provided sponsorship for the 2002 FA Youth Cup Final.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by gemma-3-27b", "tier": 1, "dataset": "ASSET", "generator_model": "gemma-3-27b", "rule_pass": true, "rule_detail": "recall=0.75,ratio=1.09"}
