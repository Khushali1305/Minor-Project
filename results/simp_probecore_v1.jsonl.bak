{"probe_id": "INV_SEM_llama-3.1-70b_ASSET_val_0551", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0551", "base_text": "In 1833 parts of Burke County and Buncombe County were combined to form Yancey County, and in 1838 the southern part of what was left of Buncombe County became Henderson County.", "probe_text": "The creation of Yancey County occurred in 1833, when portions of Burke and Buncombe counties were merged, and five years later, in 1838, the remaining southern section of Buncombe County was separated to establish Henderson County.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-70b", "tier": 1, "dataset": "ASSET", "generator_model": "llama-3.1-70b", "rule_pass": true, "rule_detail": "recall=0.65,ratio=1.16"}
