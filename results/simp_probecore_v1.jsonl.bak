{"probe_id": "patch_sem_llama_3_1_8b_ASSET_test_0039_374e47de", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "llama-3.1-8b", "base_item_id": "ASSET_test_0039", "base_text": "Formal minor planet designations are number-name combinations overseen by the Minor Planet Center, a branch of the IAU.", "probe_text": "The Minor Planet Center, an affiliate of the International Astronomical Union, assigns formal numerical identifiers to celestial bodies in conjunction with their descriptive names.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
