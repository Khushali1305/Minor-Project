{"probe_id": "INV_SEM_qwen2.5-32b_ASSET_val_0790", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0790", "base_text": "It consists of the red cross of Saint George (patron saint of England), edged in white, superimposed on the Cross of St Patrick (patron saint of Ireland), which are superimposed on the Saltire of Saint Andrew (patron saint of Scotland).", "probe_text": "It features the white-bordered red cross of Saint George, England's patron saint, overlapping the Cross of St Patrick, Ireland's patron saint, with both placed over the Saltire of Saint Andrew, Scotland's patron saint.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by qwen2.5-32b", "tier": 2, "dataset": "ASSET", "generator_model": "qwen2.5-32b", "rule_pass": true, "rule_detail": "recall=0.70,ratio=0.82"}
{"probe_id": "INV_SEM_qwen2.5-32b_ASSET_val_0793", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0793", "base_text": "Guangxi (or Guangxi Zhuang Autonomous Region;) is a Zhuang autonomous region of the People's Republic of China.", "probe_text": "The Guangxi Zhuang Autonomous Region, often referred to as Guangxi, is an autonomous area in the People's Republic of China designated for the Zhuang ethnic group.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by qwen2.5-32b", "tier": 1, "dataset": "ASSET", "generator_model": "qwen2.5-32b", "rule_pass": true, "rule_detail": "recall=0.85,ratio=1.53"}
{"probe_id": "INV_SEM_qwen2.5-32b_ASSET_val_0795", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0795", "base_text": "The Sutlej River (alternatively spelled as Satluj River) (,,,, and) is the longest of the five rivers that flow through the historic crossroad region of Punjab in northern India and Pakistan.", "probe_text": "The Satluj River, which can also be spelled as Sutlej River, is the most extended among the five waterways traversing the historical junction area of Punjab located in the northern parts of India and Pakistan.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by qwen2.5-32b", "tier": 1, "dataset": "ASSET", "generator_model": "qwen2.5-32b", "rule_pass": true, "rule_detail": "recall=0.62,ratio=1.13"}
