{"probe_id": "INV_SEM_llama-3.1-8b_ASSET_val_1964", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_1964", "base_text": "The Big Mac PPP exchange rate between two countries is obtained by dividing the price of a Big Mac in one country (in its currency) by the price of a Big Mac in another country (in its currency).", "probe_text": "To calculate the Big Mac Purchasing Power Parity (PPP) exchange rate between two nations, you need to compare the cost of purchasing a single Big Mac in each country's local currency. This involves taking the price of a Big Mac in one country and dividing it by the equivalent value of that same product in another country.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-8b", "tier": 1, "dataset": "ASSET", "generator_model": "llama-3.1-8b", "rule_pass": true, "rule_detail": "recall=0.82,ratio=1.50"}
