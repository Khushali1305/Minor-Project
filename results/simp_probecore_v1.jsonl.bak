{"probe_id": "patch_sem_gpt_4_1_ASSET_val_1712_94ff2f77", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "gpt-4.1", "base_item_id": "ASSET_val_1712", "base_text": "Primeval redwood forests, coastal mangrove stands, sphagnum bogs, desert soil crusts, roadside weed patches, wheat fields, cultivated gardens and lawns; all are encompassed by the term vegetation.", "probe_text": "The word vegetation includes ancient redwood forests, mangrove groves along coasts, sphagnum moss bogs, crusts on desert soils, patches of weeds by roads, wheat farms, as well as managed gardens and lawns.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
