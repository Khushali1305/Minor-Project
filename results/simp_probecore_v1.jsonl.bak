{"probe_id": "INV_SEM_llama-3.1-70b_ASSET_val_1793", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_1793", "base_text": "In geology, when an igneous intrusion cuts across a formation of sedimentary rock, it can be determined that the igneous intrusion is younger than the sedimentary rock.", "probe_text": "A key principle in geology states that when a formation of sedimentary rock is intersected by an igneous intrusion, the age of the intrusion is necessarily more recent than that of the sedimentary rock.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-70b", "tier": 1, "dataset": "ASSET", "generator_model": "llama-3.1-70b", "rule_pass": true, "rule_detail": "recall=0.68,ratio=1.26"}
