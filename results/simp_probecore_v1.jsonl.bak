{"probe_id": "INV_SEM_gemma-3-27b_ASSET_val_0443", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_0443", "base_text": "A Feast for Crows is the fourth of seven planned novels in A Song of Ice and Fire, an epic fantasy series by American author George R. R. Martin.", "probe_text": "The fourth book in George R. R. Martin’s ambitious, epic fantasy series, A Song of Ice and Fire—intended to span seven novels—is titled A Feast for Crows.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by gemma-3-27b", "tier": 1, "dataset": "ASSET", "generator_model": "gemma-3-27b", "rule_pass": true, "rule_detail": "recall=0.81,ratio=0.93"}
