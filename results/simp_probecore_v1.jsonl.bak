{"probe_id": "patch_sem_llama_3_1_8b_ASSET_test_0213_5699c894", "probe_family": "invariance", "probe_subtype": "semantic", "generator_model": "llama-3.1-8b", "base_item_id": "ASSET_test_0213", "base_text": "The polymer is most often epoxy, but other polymers, such as polyester, vinyl ester or nylon, are also sometimes used.", "probe_text": "While epoxy is the most commonly utilized polymer, alternative materials like polyester, vinyl ester, and nylon are occasionally employed in place of it.", "target_level": "simpler", "dataset": "ASSET", "tier": 1, "source": "patch_v1"}
