{"probe_id": "INV_SEM_llama-3.1-70b_ASSET_val_1708", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_1708", "base_text": "They can occur at any beach with breaking waves, including the world's oceans, seas, and large lakes such as the Great Lakes in the United States of America and Canada.", "probe_text": "These occurrences are not limited to specific locations, as they can take place at any coastal area where waves are breaking, encompassing global bodies of water like oceans and seas, as well as sizable inland bodies such as the Great Lakes, which border the United States and Canada.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-70b", "tier": 2, "dataset": "ASSET", "generator_model": "llama-3.1-70b", "rule_pass": true, "rule_detail": "recall=0.67,ratio=1.60"}
{"probe_id": "INV_SEM_llama-3.1-70b_ASSET_val_1887", "probe_family": "invariance", "probe_subtype": "semantic", "base_item_id": "ASSET_val_1887", "base_text": "These events were dramatized in the 1977 movie A Bridge Too Far.", "probe_text": "The film A Bridge Too Far, released in 1977, dramatized these events.", "target_level": "simpler", "expected_relation": "stable", "operation": "paraphrase by llama-3.1-70b", "tier": 2, "dataset": "ASSET", "generator_model": "llama-3.1-70b", "rule_pass": true, "rule_detail": "recall=0.82,ratio=1.00"}
